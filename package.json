{
  "name": "g2a-social-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web --port 3010",
    "build": "next build apps/web",
    "start": "next start apps/web --port 3010",
    "worker": "tsx --env-file=.env apps/worker/src/index.ts",
    "worker:prod": "tsx apps/worker/src/index.ts",
    "worker:health": "tsx --env-file=.env scripts/worker-health.ts",
    "meta:verify": "tsx --env-file=.env scripts/verify-meta-staging.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "better-auth": "^1.3.0",
    "bullmq": "^5.58.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.0",
    "next": "^16.0.0",
    "nodemailer": "10.0.6",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.55.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.8"
  }
}
