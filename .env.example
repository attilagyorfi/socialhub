APP_URL=http://localhost:3010
DATABASE_URL=postgresql://g2a:g2a_local_only@localhost:55432/g2a
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SOCIAL_PROVIDER_MODE=mock
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
# Optional USD-per-million-token rates used only for generation cost estimates.
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=
AYRSHARE_API_KEY=
META_APP_ID=
META_APP_SECRET=
# Live Meta calls remain disabled unless this flag is explicitly enabled.
META_INTEGRATION_ENABLED=false
# Pin the Graph API version approved for the configured Meta app (for example vNN.N).
META_GRAPH_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
# UUID of a direct Meta account connected through this application in staging.
META_STAGING_ACCOUNT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://localhost:9000
# Set this when the worker's internal S3 endpoint is not browser-reachable.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=g2a-media
S3_ACCESS_KEY=g2a_local
S3_SECRET_KEY=g2a_local_storage_only
# Local bootstrap only. Leave false in production and provision bucket/CORS separately.
S3_MANAGE_BUCKET=true
# Optional overrides; defaults to ffmpeg and ffprobe on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=G2A Social Hub <noreply@example.test>
DEMO_EMAIL=owner@example.test
DEMO_PASSWORD=
DATA_RETENTION_DAYS=365
# Release identifier shown by health checks and worker heartbeat metadata.
APP_REVISION=development
# Production defaults to requiring a fresh worker heartbeat. Local development does not.
HEALTH_REQUIRE_WORKER=false
HEALTH_REQUIRE_STORAGE=true

